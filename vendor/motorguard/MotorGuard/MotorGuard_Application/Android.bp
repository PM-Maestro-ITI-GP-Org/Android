    name: "libfilament-utils-jni",
    arch: { arm64: { srcs: ["prebuilts/jni/arm64-v8a/libfilament-utils-jni.so"] } },
    compile_multilib: "64",
    check_elf_files: false,
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    shared_libs: [],
}

