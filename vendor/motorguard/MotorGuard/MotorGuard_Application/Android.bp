// Motor Guard — AAOS launcher, built inside the AOSP / Raspberry Pi tree and
// platform-signed. This repo IS the drop-in: copy it whole into your device or
// vendor tree as vendor/motorguard/MotorGuard/. Every path below is already
// relative to this file, so nothing needs adjusting.
//
// Two ways to build it — pick ONE:
//   (A) android_app  — compile from source in the tree (this file's default).
//   (B) android_app_import — bundle a Gradle-built, platform-re-signed APK (bottom).
//       Use (B) if your tree's AndroidX/Compose prebuilts don't match; it's the most
//       reliable path for a Compose app.

// ---------------------------------------------------------------------------
// (A) Build from source.
// ---------------------------------------------------------------------------
android_app {
    name: "MotorGuard",

    srcs: [
        "app/MotorGuardApp/app/src/main/java/**/*.kt",
        // Diagnostics domain + the fake data source it currently runs against. Gradle
        // builds these as the library modules :core:vehicle-data-api and
        // :core:vehicle-data-fake; neither carries resources or a manifest, so Soong
        // compiles them straight into the app instead of as android_library modules.
        // vehicle-data-fake is the swap target for the real SOME/IP bridge — when that
        // lands, its sources join this list (and the fake's leave it).
        "app/MotorGuardApp/core/vehicle-data-api/src/main/java/**/*.kt",
        "app/MotorGuardApp/core/vehicle-data-fake/src/main/java/**/*.kt",
        // The SOME/IP bridge to the diagnostics unit. Unlike everything above
        // it lives in this drop-in rather than in the app branch, because it
        // only makes sense next to libmotorguardsomeip and because the Gradle
        // build has no way to produce that library. deploy.sh applies
        // motorservice/vehicledata-someip.patch to hand it the motor signal.
        "motorservice/java/**/*.kt",
    ],
    resource_dirs: [
        "app/MotorGuardApp/app/src/main/res",
        // Overlay that flips bool/use_real_connectivity -> true for the real build.
        "res-platform",
    ],
    manifest: "app/MotorGuardApp/app/src/main/AndroidManifest.xml",

    // Voice wake-word models (openWakeWord *.onnx) and the diagnostics vehicle model
    // (car_model.glb). ORT mmaps the .onnx files and the .glb is already-compressed
    // texture payload, so neither is worth re-zipping — both stay stored (mirrors
    // android.androidResources.noCompress "onnx"/"glb" in build.gradle.kts).
    //
    // car_model.glb is NOT in the app branch (it is .gitignored — 15 MB of binary).
    // deploy.sh installs it into this directory from vehicle3dModel/ in the same
    // checkout before the tree is copied. Without that step the diagnostics stage
    // renders an empty scene.
    asset_dirs: ["app/MotorGuardApp/app/src/main/assets"],
    aaptflags: [
        "-0 .onnx",
        "-0 .glb",
    ],

    // The native reasoning/voice core (see cc_library_shared below) and the
    // ONNX Runtime prebuilt (android_library_import below) — the two pieces the
    // Vega voice subsystem added on top of the pure-Compose launcher.
    jni_libs: [
        "libmotorguardvoice",
        "libmotorguardsomeip",
        // The AARs' own native libraries. Listing motorguard-filament et al. in
        // static_libs is NOT enough: `extract_jni: true` never fires for an
        // android_library_import in this tree (ctx.MultiTargets() is empty), so no
        // *_jni.zip is produced and the APK ends up with zero lib/ entries. These are
        // cc_prebuilt_library_shared modules over the .so files prebuilts/fetch.sh
        // unzips out of those same AARs — see the bottom of this file.
        "libfilament-jni",
        "libgltfio-jni",
        "libfilament-utils-jni",
        "libmaplibre",
        "libonnxruntime",
        "libonnxruntime4j_jni",
    ],

    // System APIs (WifiManager/BluetoothAdapter control) + platform signing so the app
    // can be HOME and hold privileged permissions.
    platform_apis: true,
    certificate: "platform",
    privileged: true,

    // Replace the stock Car launcher: CarLauncher is NOT installed, and Motor Guard
    // (which declares the HOME intent-filter) becomes the default launcher from first
    // boot — no runtime set-home-activity needed. Confirm the module name in your tree
    // (usually "CarLauncher"; packages/apps/Car/Launcher).
    overrides: ["CarLauncher"],

    static_libs: [
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.activity_activity-compose",
        "androidx.annotation_annotation",
        "androidx.palette_palette",
        "androidx.savedstate_savedstate",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.foundation_foundation",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material",
        "androidx.compose.material_material-icons-extended",
        "kotlinx-coroutines-core",
        "kotlinx-coroutines-android",
        "kotlinx-coroutines-guava",
        // ONNX Runtime (ai.onnxruntime.*) — not in AOSP prebuilts, vendored as an
        // AAR via the android_library_import below. You must drop the .aar in first.
        "motorguard-onnxruntime",
        // media3 1.4.1 (ExoPlayer + MediaLibraryService) — vendored AARs, see the
        // android_library_import modules below.
        "androidx.media3_media3-common",
        "androidx.media3_media3-exoplayer",
        "androidx.media3_media3-session",
        // MapLibre Native 11.8.0 (nav map) — vendored AARs, see the import below.
        "motorguard-maplibre",
        // SceneView 2.3.0 + Filament (diagnostics 3D car stage) — vendored AARs, see
        // the imports below. Pinned to 2.3.0 because it is the last release built
        // against kotlin-stdlib 2.0.21; 4.x needs Kotlin 2.3+.
        "motorguard-sceneview",
        // Filament AARs are listed transitively under motorguard-sceneview, but Soong only
        // collects AAR JNI packages (JniPackageProvider) for DIRECT static_libs of the app
        // -- WalkDeps does not recurse through Java AAR imports (see app.go collectAppDeps).
        // Without these listed here, libfilament-jni.so / libgltfio-jni.so /
        // libfilament-utils-jni.so never reach the APK, so SceneView dies at startup
        // with UnsatisfiedLinkError -> white screen / no diagnostics scene.
        "motorguard-filament",
        "motorguard-filament-gltfio",
        "motorguard-filament-utils",
    ],

    // Jetpack Compose compiler plugin: applied AUTOMATICALLY by Soong when
    // androidx.compose.runtime_runtime is in static_libs (build/soong/java/base.go
    // useCompose + kotlinPluginTag). Do NOT list it in `plugins:` — that property only
    // accepts java_plugin modules, and the compose compiler is a java_import_host here.
    // R8's shrinking pass throws "Attribute EnclosingMethod requires InnerClasses
    // attribute" on one of the SceneView/Filament/prebuilt AARs. Fix it the right
    // way (keep the attributes) rather than disabling R8: the moment R8 is off the
    // app routes through plain D8, which has been observed to drop the AAR JNI libs
    // from the APK (libfilament-jni.so/libonnxruntime.so etc.) -> UnsatisfiedLinkError.
    optimize: {
        proguard_flags_files: ["proguard-r8.flags"],
    },

    // Ships in /system/priv-app so `privileged: true` + the allow-list below apply.
    // required pulls in both permission files at build time: the privileged
    // allow-list, and the default runtime grants (mic/location/contacts/BT).
    required: [
        "privapp_permissions_com.motorguard.ivi",
        "default_permissions_com.motorguard.ivi",
    ],
}

// The privileged-permission allow-list, installed to /system/etc/permissions.
prebuilt_etc {
    name: "privapp_permissions_com.motorguard.ivi",
    sub_dir: "permissions",
    src: "privapp_permissions_com.motorguard.ivi.xml",
    filename_from_src: true,
}

// Default RUNTIME permission grants, installed to /system/etc/default-permissions.
// Distinct from the allow-list above: that one covers privileged permissions, this
// one pre-grants the dangerous/runtime permissions (mic, location, contacts, BT) that
// would otherwise sit denied because nothing on a HOME-launching head unit ever taps
// through a permission dialog.
prebuilt_etc {
    name: "default_permissions_com.motorguard.ivi",
    sub_dir: "default-permissions",
    src: "default_permissions_com.motorguard.ivi.xml",
    filename_from_src: true,
}

// ---------------------------------------------------------------------------
// Native voice/reasoning core — loaded by VoiceEngine.kt, WhisperStt.kt and
// PiperTts.kt via System.loadLibrary("motorguardvoice").
//
// This is a PREBUILT, not a source build. The app's committed jniLibs copy is
// produced by the Gradle/CMake build (app/MotorGuardApp/app/src/main/cpp/
// CMakeLists.txt) and bundles Whisper (whisper.cpp + ggml) and espeak-ng
// STATICALLY, so the .so is fully self-contained (DT_NEEDED is only
// liblog/libdl/libm/libc — no libc++ runtime).
//
// Soong CANNOT reproduce that lib from source: compiling whisper_jni.cpp /
// espeak_jni.cpp would require vendoring the whisper.cpp and espeak-ng trees,
// which are gitignored third-party clones (see cpp/.gitignore), and the
// previous source-built libmotorguardvoice omitted those JNI files entirely —
// the device then failed with:
//
//   java.lang.UnsatisfiedLinkError: No implementation found for
//     WhisperStt.nativeInit ... PiperTts.nativeInitEspeak
//
// Using the prebuilt is the same pattern as libfilament-jni/libonnxruntime
// below, and keeps the in-tree APK feature-identical to the Gradle one.
// ---------------------------------------------------------------------------
cc_prebuilt_library_shared {
    name: "libmotorguardvoice",
    arch: {
        arm64: {
            srcs: ["app/MotorGuardApp/app/src/main/jniLibs/arm64-v8a/libmotorguardvoice.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    shared_libs: [],
}

// ---------------------------------------------------------------------------
// The SOME/IP client for the diagnostics unit's motor service — the transport
// behind the diagnostics screen's live fault state and its capture button.
// Sources live in this drop-in, not in the app submodule: they are only
// buildable in a tree (there is no Gradle path to a platform .so), and they
// are the AOSP half of a contract whose other half is on the Pi.
//
// No vsomeip and no CommonAPI. Both need Boost, which AOSP does not ship, so
// using them would mean vendoring Boost into the tree and maintaining it for
// a client that speaks exactly two message types. SOME/IP's whole point is
// that interoperation happens at the wire, so the peer keeps its vsomeip
// stack and this speaks the same bytes at it. See motorservice/README.md for
// the wire contract and the ID assignment.
// ---------------------------------------------------------------------------
cc_library_shared {
    name: "libmotorguardsomeip",

    srcs: ["motorservice/src/*.cpp"],
    local_include_dirs: ["motorservice/include"],
    header_libs: ["jni_headers"], // jni.h (libnativehelper/include_jni)

    cppflags: ["-std=c++17"],
    // Warnings are errors here on purpose: every bug this library can have is
    // an off-by-one in a byte offset, and -Wall catches a useful fraction of
    // them before the link fails to come up on a device.
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: ["liblog"],
}

// Host tests for the parts with no sockets in them: framing, the two payload
// layouts, and the SD entry/option encoding.
//
//     m motorguard_someip_test && out/host/linux-x86/bin/motorguard_someip_test
//
// Everything below the socket boundary is deliberately reachable this way.
// The alternative is discovering a wrong nibble in a subscribe entry by
// watching a head unit show "No data" with no error anywhere.
cc_test_host {
    name: "motorguard_someip_test",

    srcs: [
        "motorservice/src/wire.cpp",
        "motorservice/src/sd.cpp",
        "motorservice/test/wire_test.cpp",
    ],
    local_include_dirs: ["motorservice/include"],

    cppflags: ["-std=c++17"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// ONNX Runtime for Android (ai.onnxruntime.*). AOSP has no onnxruntime prebuilt,
// so vendor the official AAR and import it. Download onnxruntime-android-1.19.2.aar
// (the version pinned in build.gradle.kts) from Maven Central and drop it at the
// path below; extract_jni pulls its bundled libonnxruntime*.so into the app.
android_library_import {
    name: "motorguard-onnxruntime",
    aars: ["prebuilts/onnxruntime-android-1.19.2.aar"],
    sdk_version: "current",
    extract_jni: true,
}

// ---------------------------------------------------------------------------
// kotlinx-coroutines-guava 1.8.1 — bridges Guava ListenableFuture (returned by the
// media3 session callbacks) to coroutines. JVM-only artifact (no AAR), fetched from
// Maven Central. Brings `guava` onto the app classpath transitively.
// ---------------------------------------------------------------------------
java_import {
    name: "kotlinx-coroutines-guava",
    jars: ["prebuilts/kotlinx-coroutines-guava-1.8.1.jar"],
    sdk_version: "current",
    static_libs: ["guava"],
}

// ---------------------------------------------------------------------------
// media3 1.4.1 (ExoPlayer + MediaLibraryService session) — not in AOSP prebuilts,
// vendored AARs from Google Maven (dl.google.com/android/maven2). Each import lists
// its REAL transitive deps so the compile classpath matches the Gradle build.
// androidx.media 1.7.0-alpha02, collection, core, annotation, exifinterface and
// concurrent-futures all exist in the tree prebuilts.
// ---------------------------------------------------------------------------
android_library_import {
    name: "androidx.media3_media3-common",
    aars: ["prebuilts/media3-common-1.4.1.aar"],
    sdk_version: "current",
    static_libs: [
        "androidx.annotation_annotation",
        "androidx.collection_collection",
        "androidx.concurrent_concurrent-futures",
        "androidx.media_media",
        "guava",
    ],
}

android_library_import {
    name: "androidx.media3_media3-database",
    aars: ["prebuilts/media3-database-1.4.1.aar"],
    sdk_version: "current",
    static_libs: ["androidx.media3_media3-common"],
}

android_library_import {
    name: "androidx.media3_media3-datasource",
    aars: ["prebuilts/media3-datasource-1.4.1.aar"],
    sdk_version: "current",
    static_libs: ["androidx.media3_media3-common"],
}

android_library_import {
    name: "androidx.media3_media3-decoder",
    aars: ["prebuilts/media3-decoder-1.4.1.aar"],
    sdk_version: "current",
    static_libs: ["androidx.media3_media3-common"],
}

android_library_import {
    name: "androidx.media3_media3-extractor",
    aars: ["prebuilts/media3-extractor-1.4.1.aar"],
    sdk_version: "current",
    static_libs: [
        "androidx.media3_media3-common",
        "androidx.media3_media3-datasource",
    ],
}

android_library_import {
    name: "androidx.media3_media3-container",
    aars: ["prebuilts/media3-container-1.4.1.aar"],
    sdk_version: "current",
    static_libs: ["androidx.media3_media3-common"],
}

android_library_import {
    name: "androidx.media3_media3-exoplayer",
    aars: ["prebuilts/media3-exoplayer-1.4.1.aar"],
    sdk_version: "current",
    static_libs: [
        "androidx.media3_media3-common",
        "androidx.media3_media3-container",
        "androidx.media3_media3-database",
        "androidx.media3_media3-datasource",
        "androidx.media3_media3-decoder",
        "androidx.media3_media3-extractor",
        "androidx.annotation_annotation",
        "androidx.collection_collection",
        "androidx.core_core",
        "androidx.exifinterface_exifinterface",
    ],
}

android_library_import {
    name: "androidx.media3_media3-session",
    aars: ["prebuilts/media3-session-1.4.1.aar"],
    sdk_version: "current",
    static_libs: [
        "androidx.media3_media3-common",
        "androidx.media3_media3-datasource",
        "androidx.collection_collection",
        "androidx.core_core",
        "androidx.media_media",
    ],
}

// ---------------------------------------------------------------------------
// MapLibre Native (org.maplibre.android.*) — the nav map. android-sdk 11.8.0
// bundles libmaplibre.so (extract_jni). Deps mirrored from the POM; tree libs
// (gson, okhttp, androidx.*) are used where available, everything else is
// vendored into prebuilts/ (see README).
// ---------------------------------------------------------------------------
android_library_import {
    name: "motorguard-maplibre",
    aars: ["prebuilts/android-sdk-11.8.0.aar"],
    sdk_version: "current",
    extract_jni: true, // jni/arm64-v8a/libmaplibre.so
    static_libs: [
        "motorguard-maplibre-geojson",
        "motorguard-maplibre-gestures",
        "motorguard-maplibre-turf",
        "motorguard-maplibre-timber",
        "motorguard-okhttp",
        "androidx.annotation_annotation",
        "androidx.fragment_fragment",
        "androidx.interpolator_interpolator",
    ],
}

java_import {
    name: "motorguard-okhttp",
    jars: ["prebuilts/okhttp-4.12.0.jar"],
    static_libs: [
        "motorguard-okio",
        "kotlin-stdlib",
    ],
}

java_import {
    name: "motorguard-okio",
    jars: ["prebuilts/okio-jvm-3.6.0.jar"],
}

java_import {
    name: "motorguard-maplibre-geojson",
    jars: ["prebuilts/android-sdk-geojson-6.0.1.jar"],
    static_libs: ["gson"],
}

java_import {
    name: "motorguard-maplibre-turf",
    jars: ["prebuilts/android-sdk-turf-6.0.1.jar"],
    static_libs: ["motorguard-maplibre-geojson"],
}

android_library_import {
    name: "motorguard-maplibre-gestures",
    aars: ["prebuilts/maplibre-android-gestures-0.0.3.aar"],
    sdk_version: "current",
    static_libs: [
        "kotlin-stdlib",
        "androidx.annotation_annotation",
        "androidx.core_core-ktx",
    ],
}

android_library_import {
    name: "motorguard-maplibre-timber",
    aars: ["prebuilts/timber-5.0.1.aar"],
    sdk_version: "current",
}

// ---------------------------------------------------------------------------
// SceneView 2.3.0 (io.github.sceneview.*) — the diagnostics 3D car stage, Filament
// under the hood. Deps mirrored from its POM: kotlin-math and the three Filament
// AARs at compile scope, fragment-ktx / compose ui+foundation at runtime (all three
// already on the app classpath above). The `fuel` runtime deps are for loading glTF
// over HTTP; this app loads car_model.glb from assets and never reaches that code.
//
// They are STILL vendored, though. SceneView's FileLoader.<clinit> assigns its
// fuelManager field, and the class is loaded the moment any model is loaded —
// asset or URL. Without fuel on the classpath the loader dies before it can read
// the asset:
//
//   java.lang.NoClassDefFoundError: Failed resolution of:
//     Lcom/github/kittinunf/fuel/core/FuelManager;
//
// So the three fuel artifacts (fuel, fuel-android, fuel-coroutines — plus their
// `result` dep) are fetched by prebuilts/fetch.sh and imported below.
//
// The SceneView AAR also SHIPS ASSETS the app loads at runtime:
// assets/environments/neutral/neutral_ibl.ktx (indirect lighting, see
// Car3dTuning.NEUTRAL_IBL_ASSET) and assets/materials/*.filamat. Soong merges an
// AAR's assets into the app package the same way Gradle does. If the stage ever
// comes up unlit with "asset not found" in logcat, that merge is the thing to check
// first — the fallback is to unzip the AAR's assets/ into a directory here and add
// it to asset_dirs above.
// ---------------------------------------------------------------------------
android_library_import {
    name: "motorguard-sceneview",
    aars: ["prebuilts/sceneview-2.3.0.aar"],
    sdk_version: "current",
    static_libs: [
        "motorguard-filament",
        "motorguard-filament-gltfio",
        "motorguard-filament-utils",
        "motorguard-kotlin-math",
        "motorguard-fuel",
        "motorguard-fuel-android",
        "motorguard-fuel-coroutines",
        "kotlin-stdlib",
        "androidx.fragment_fragment-ktx",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
    ],
}

// Fuel 2.3.1 — SceneView's FileLoader runtime dep (see comment above). fuel-core is a
// plain JVM jar; fuel-android brings the Android bridge (an AAR, tiny); fuel-coroutines
// adds the coroutine `await` helpers SceneView's loadFileBuffer uses. `result` is fuel's
// Result type. Mirrored from sceneview-2.3.0.pom.
java_import {
    name: "motorguard-fuel",
    jars: ["prebuilts/fuel-2.3.1.jar"],
    sdk_version: "current",
    static_libs: [
        "motorguard-result",
        "kotlin-stdlib",
    ],
}

android_library_import {
    name: "motorguard-fuel-android",
    aars: ["prebuilts/fuel-android-2.3.1.aar"],
    sdk_version: "current",
    static_libs: [
        "motorguard-fuel",
        "kotlin-stdlib",
    ],
}

java_import {
    name: "motorguard-fuel-coroutines",
    jars: ["prebuilts/fuel-coroutines-2.3.1.jar"],
    sdk_version: "current",
    static_libs: [
        "motorguard-fuel",
        "kotlinx-coroutines-core",
        "kotlin-stdlib",
    ],
}

java_import {
    name: "motorguard-result",
    jars: ["prebuilts/result-3.1.0.jar"],
    sdk_version: "current",
}

// Filament 1.56.0 — the renderer itself. extract_jni pulls libfilament-jni.so out of
// the AAR (and libgltfio-jni.so / libfilament-utils-jni.so out of the two below);
// SceneView loads all three with System.loadLibrary at Engine creation.
android_library_import {
    name: "motorguard-filament",
    aars: ["prebuilts/filament-android-1.56.0.aar"],
    sdk_version: "current",
    extract_jni: true,
}

// glTF loading (com.google.android.filament.gltfio.*) — this is what reads car_model.glb.
android_library_import {
    name: "motorguard-filament-gltfio",
    aars: ["prebuilts/gltfio-android-1.56.0.aar"],
    sdk_version: "current",
    extract_jni: true,
    static_libs: ["motorguard-filament"],
}

// KTX texture / IBL loading (com.google.android.filament.utils.*) — the neutral
// environment the stage is lit with.
android_library_import {
    name: "motorguard-filament-utils",
    aars: ["prebuilts/filament-utils-android-1.56.0.aar"],
    sdk_version: "current",
    extract_jni: true,
    static_libs: [
        "motorguard-filament",
        "motorguard-filament-gltfio",
        "motorguard-kotlin-math",
        "kotlin-stdlib",
    ],
}

// dev.romainguy:kotlin-math 1.5.3 — the Float3/Quaternion/lookAt maths SceneView's API
// speaks, used directly by Car3dRenderer for the camera rig. Multiplatform artifact;
// the -jvm jar is the Android one.
java_import {
    name: "motorguard-kotlin-math",
    jars: ["prebuilts/kotlin-math-jvm-1.5.3.jar"],
    sdk_version: "current",
    static_libs: ["kotlin-stdlib"],
}

// ---------------------------------------------------------------------------
// (B) Prebuilt APK alternative (build the APK with Gradle first: ./gradlew assembleRelease
//     then drop app-release.apk here). Comment out module (A) if you use this.
// ---------------------------------------------------------------------------
// android_app_import {
//     name: "MotorGuard",
//     apk: "app-release.apk",
//     certificate: "platform",
//     privileged: true,
//     overrides: ["CarLauncher"],
//     dex_preopt: { enabled: false },
//     required: ["privapp_permissions_com.motorguard.ivi"],
// }

// ---------------------------------------------------------------------------
// Native libraries carried inside the vendored AARs.
//
// These exist because `extract_jni: true` on the android_library_import modules
// above does NOT work in this tree: Soong only emits the <arch>_jni.zip that
// feeds the APK for each entry in ctx.MultiTargets(), and that list is empty for
// an android_library_import here. Nothing fails at build time — the APK simply
// ships with zero lib/ entries, and the app dies on first use of the 3D stage:
//
//     java.lang.UnsatisfiedLinkError: dlopen failed:
//       library "libfilament-jni.so" not found
//
// ONNX Runtime and MapLibre fail the same way, quieter: the wake word never
// arms and the nav map silently falls back to the Canvas renderer.
//
// prebuilts/fetch.sh unzips these out of the AARs it already downloads and
// SHA256-verifies, so nothing extra is committed and the checksums still cover
// them. Listing them in the app's jni_libs installs them to /system/lib64 with a
// symlink in /system/priv-app/MotorGuard/lib/arm64 — the same shape that
// libmotorguardvoice and libmotorguardsomeip already have on a working image.
//
// check_elf_files is off because these are third-party binaries linked against
// the NDK, not the platform: their DT_NEEDED entries do not resolve against
// AOSP's stubs and Soong would otherwise reject them.
// ---------------------------------------------------------------------------
cc_prebuilt_library_shared {
    name: "libfilament-jni",
    arch: { arm64: { srcs: ["prebuilts/jni/arm64-v8a/libfilament-jni.so"] } },
    compile_multilib: "64",
    check_elf_files: false,
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    shared_libs: [],
}

cc_prebuilt_library_shared {
    name: "libgltfio-jni",
    arch: { arm64: { srcs: ["prebuilts/jni/arm64-v8a/libgltfio-jni.so"] } },
    compile_multilib: "64",
    check_elf_files: false,
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    shared_libs: [],
}

