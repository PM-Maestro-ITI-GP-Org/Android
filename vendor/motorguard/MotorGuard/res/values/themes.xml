        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="android:colorBackground">@color/screen</item>
        <item name="android:navigationBarColor">@color/rail_bg</item>
        <!-- Corner radius / elevation live in dimens.xml -->
    </style>
</resources>
