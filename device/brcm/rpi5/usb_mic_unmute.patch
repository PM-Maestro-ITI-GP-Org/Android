+// USB microphones ship with the capture path muted by default. The USB audio
+// module only drives output volumes, so an opened input stream patches through
+// to the hardware yet pcm_read() returns no samples. Flip the capture switch
+// and raise the capture volume for the card the input opened on. Robust to the
+// variant control names ("Capture Switch" generic vs "Mic Capture Switch") and
+// to boards that don't expose either control at all.
+void StreamAlsa::unmuteCapture(int card) {
+    if (card < 0) return;
+    struct mixer_ctl* ctl = nullptr;
+    struct mixer* mixer = mixer_open(card);
+    if (mixer == nullptr) {
+        PLOG(WARNING) << "unmuteCapture: mixer_open failed for card " << card;
+        return;
+    }
+    // Try the common names in priority order; the C-Media "USB PnP" uses
+    // "Mic Capture Switch" (INV_BOOLEAN).
+    for (const char* name : {"Mic Capture Switch", "Capture Switch"}) {
+        ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl != nullptr) break;
+    }
+    if (ctl == nullptr) {
+        LOG(DEBUG) << "unmuteCapture: no capture-switch control on card " << card;
+        mixer_close(mixer);
+        return;
+    }
+    int cur = mixer_ctl_get_value(ctl, 0);
+    // Boolean mute switches are usually inactive-high: 1 = unmuted.
+    if (cur != 1) {
+        if (mixer_ctl_set_value(ctl, 0, 1) != 0) {
+            LOG(WARNING) << "unmuteCapture: could not unmute capture switch on card " << card;
+        } else {
+            LOG(INFO) << "unmuteCapture: capture switch enabled on card " << card;
+        }
+    }
+    // Some USB codecs also need the capture volume nonzero to actually run.
+    const char* volName = nullptr;
+    ctl = mixer_get_ctl_by_name(mixer, "Mic Capture Volume");
+    if (ctl == nullptr) {
+        ctl = mixer_get_ctl_by_name(mixer, "Capture Volume");
+        volName = "Capture Volume";
+    } else {
+        volName = "Mic Capture Volume";
+    }
+    if (ctl != nullptr) {
+        int maxv = mixer_ctl_get_range_max(ctl);
+        if (maxv > 0) {
+            mixer_ctl_set_value(ctl, 0, maxv / 2);  // 50% gain
+            LOG(INFO) << "unmuteCapture: " << volName << " set to " << (maxv / 2)
+                      << " on card " << card;
+        }
+    }
+    mixer_close(mixer);
+}
+
 }  // namespace aidl::android::hardware::audio::core
