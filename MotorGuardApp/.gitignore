# Vendored third-party native trees — clone these, don't commit them:
#   git clone --depth 1 https://github.com/ggerganov/whisper.cpp
#   git clone --depth 1 https://github.com/espeak-ng/espeak-ng
/app/src/main/cpp/whisper.cpp/
/app/src/main/cpp/espeak-ng/

.kotlin/

# The 3D vehicle model is installed by scripts/select-car-model.sh from the model
# library outside the repo. It is ~15 MB of binary — keep it out of git history.
/app/src/main/assets/car_model.glb
/app/src/main/assets/car_model.source.txt
