<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marks the app as an Automotive app so it shows in the AAOS launcher grid. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Wi-Fi: read + control. Radio control (CHANGE_WIFI_STATE toggle/connect) only takes
         effect on a platform-signed / privileged build; unprivileged it falls back to mock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Scan results need location (pre-33) or NEARBY_WIFI_DEVICES (33+). Also used by Nav. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Bluetooth (API 31+). Legacy perms for older platforms. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Privileged radio control. These are signature|privileged: they are granted only to a
         platform-signed app in /system/priv-app that is also listed in privapp-permissions
         (see aosp/privapp_permissions_com.motorguard.ivi.xml — the two files must agree, or the
         app is blocked at boot). Without them the direct calls are refused and the toggles fall
         back to the system screens:
           NETWORK_SETTINGS     — WifiManager.setWifiEnabled + connect/forget on Android 10+
           OVERRIDE_WIFI_CONFIG — edit networks this app did not create
           BLUETOOTH_PRIVILEGED — BluetoothAdapter.enable/disable, removeBond, A2DP connect
         On a normal (unprivileged) build they are simply not granted, which is harmless. -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.OVERRIDE_WIFI_CONFIG" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <!-- Voice overlay (owner D): always-on wake word + assistant session. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Navigation: map tiles, routing (Valhalla) and search (Photon) are plain HTTPS calls.
         ACCESS_NETWORK_STATE lets the Nav tab detect "no internet" up front and fall back to
         its offline Canvas map instead of rendering an empty world. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- NavService keeps turn-by-turn guidance running when the app is backgrounded, so the
         drive survives more than a tab switch. FOREGROUND_SERVICE is the base grant;
         FOREGROUND_SERVICE_LOCATION matches the service's "location" type (API 34+); the location
         runtime perms it also needs are already declared above (ACCESS_FINE/COARSE_LOCATION).
         POST_NOTIFICATIONS (API 33+) is for the ongoing "Navigating" notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Media: the player keeps running with the app in the background, so it is a foreground
         service of type mediaPlayback (required from API 34). POST_NOTIFICATIONS is what makes
         its transport notification visible on API 33+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading the on-device / USB library. The storage permission was split by media type in
         API 33, so both spellings are needed to cover minSdk 29 upwards. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Detecting a connected phone for the Bluetooth source (runtime permission from API 31). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotorGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:screenOrientation="landscape">
            <!-- Boots as the dashboard HOME (replaces the stock CarLauncher) while
                 still appearing in the app list. Set it as default home with:
                 adb shell cmd package set-home-activity com.motorguard.ivi/.MainActivity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice overlay — system services, NOT launchable activities.
             Register the app as the assistant, then trigger it:
               adb shell settings put secure voice_interaction_service \
                 com.motorguard.ivi/.ui.voice.VoiceOverlayService -->
        <service
            android:name=".ui.voice.VoiceOverlayService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <service
            android:name=".ui.voice.VoiceSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- Foreground service that keeps navigation guidance alive across tab switches and while
             the app is backgrounded. Not launchable; started/stopped by NavSession at the
             guidance boundaries. "location" type because it tracks the car's position. -->
        <service
            android:name=".ui.nav.NavService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- The player. Exported and advertising both the media3 and the legacy MediaBrowser
             actions so the car's own media UI, the voice assistant and any other controller can
             browse and control it without this app's Activity being alive. -->
        <service
            android:name=".media.MotorGuardMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

    </application>
</manifest>
