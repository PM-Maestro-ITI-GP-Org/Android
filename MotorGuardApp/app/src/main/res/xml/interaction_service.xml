<?xml version="1.0" encoding="utf-8"?>
<!--
  recognitionService points at the offline recogniser. Stock AAOS ships no
  RecognitionService at all, so until this existed
  SpeechRecognizer.isRecognitionAvailable() returned false and every session
  opened deaf.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.motorguard.ivi.ui.voice.VoiceSessionService"
    android:recognitionService="com.motorguard.ivi.ui.voice.OfflineRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false" />