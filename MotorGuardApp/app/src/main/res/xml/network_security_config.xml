<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is blocked — the platform default since targetSdk 28, and nothing this app talks
  to needs an exception from it.

  That used to not be true: Radio stations came from the radio-browser.info community directory,
  whose URLs are whatever thousands of independent broadcasters happened to put in front of their
  Icecast server, and roughly seven in ten of those were plain http://. Blocking cleartext then
  meant the Radio tab listed stations that failed the moment they were tapped.

  Radio is SomaFM now (see SomaFm.kt) — a small, staffed set of channels served entirely from
  SomaFM's own infrastructure, and every stream URL resolved from it is https://. Every other
  endpoint (tiles, routing, search, weather) was already hardcoded https:// in NavConfig and
  WeatherService regardless of what this file said. There is nothing left that needs an exception.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
