<?xml version="1.0" encoding="utf-8"?>
<!-- Host layout: the dark NavRail runs full height on the left (no light/dark corner at
     the top). To its right: a StatusBar on top, then the fragment container below.

     ConstraintLayout, not nested weighted LinearLayouts: a LinearLayout with
     layout_height="0dp" + layout_weight gives its child an unbounded first-pass
     measurement before the weight is resolved, which Compose turns into
     Constraints(maxHeight = Infinity) for whatever fragment is hosted in
     fragment_container. Screens without a scrolling composable never noticed; the
     dialer's Modifier.verticalScroll() throws on it immediately. Anchoring everything
     to fixed edges here means fragment_container is never measured unbounded. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/nav_rail"
        android:layout_width="92dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/nav_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/nav_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
