<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Host-activity theme. Compose does the real styling; this just sets the window
         background so there is no white flash before Compose draws. DayNight picks
         values/ vs values-night/ automatically from UiMode / the light sensor. -->
    <style name="Theme.MotorGuard" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
    </style>
</resources>
